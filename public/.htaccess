# Serve the site's own 404 page for unknown URLs
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One hop to https://incredibleheart.care for http and www requests
  RewriteCond %{HTTP_HOST} ^www\.incredibleheart\.care$ [NC,OR]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://incredibleheart.care%{REQUEST_URI} [R=301,L]
</IfModule>
